title: "Human Foundations for an Age of AI: Public Working Framework v0.1"
authors:
  - family-names: "Delaile"
    given-names: "Simon"
version: "0.1"
date-released: 2026-09-14
url: "https://github.com/simondelaile85sd-hub/human-foundations-age-of-ai"
